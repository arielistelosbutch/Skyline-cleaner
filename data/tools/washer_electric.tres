script = ExtResource("1_tool")
id = "washer_electric"
display_name = "Elektrický stěrač s nádržkou"
description = "Ruční elektrický stěrač s malou nádržkou na přípravek. U vody ho naplníš jako rozprašovač a pak sám dávkuje přípravek na sklo, dokud s ním jezdíš – bez stříkání [F]. Nádržka vydrží asi 90 sekund jízdy, potom zase k vodě. Lišta 28 cm stírá jako stěrka."
