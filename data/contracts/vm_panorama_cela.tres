[resource]
script = ExtResource("1_c")
id = "vm_panorama_cela"
title = "Rezidence Panorama – celá budova kolem dokola"
building_type = "Bytová věž (14 podlaží), všechny čtyři fasády"
location = "Velkoměsto – Horizont, jih bulváru"
description = "Správa domu chce jednou za rok umýt úplně všechno: 182 oken od 1. do 13. patra na přední, zadní i obou bočních stranách. Je to práce na dlouho, ale za každé patro umyté kolem dokola je bonus XP a na konci velká odměna. Na každé straně střechy čeká závěsná plošina, drony z depa pomůžou."
dirt_level_text = "Střední až silná (celoroční špína)"
recommended_equipment = "Závěsná plošina (na každé straně), drony z depa, turbo navijáky"
reward_money = 75000
reward_xp = 7500
bonus_goal = "Za každé patro umyté kolem dokola +300 XP. Nepovinné: hotovo do 300 minut práce = +7500 Kč."
