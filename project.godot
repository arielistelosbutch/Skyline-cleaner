; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Clear View – Window Cleaning Simulator"
config/description="Relaxační simulátor mytí oken z pohledu první osoby."
config/version="0.7.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/autoload/settings.gd"
InputSetup="*res://scripts/autoload/input_setup.gd"
Events="*res://scripts/autoload/events.gd"
Talents="*res://scripts/autoload/talent_manager.gd"
GameState="*res://scripts/autoload/game_state.gd"
Shop="*res://scripts/autoload/shop.gd"
WindowRegistry="*res://scripts/autoload/window_registry.gd"
ContractManager="*res://scripts/autoload/contract_manager.gd"
WorldMap="*res://scripts/autoload/world_map.gd"
Audio="*res://scripts/autoload/audio_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
Updater="*res://scripts/autoload/updater.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.62, 0.78, 0.92, 1)

[shader_globals]

season_spring={
"type": "float",
"value": 0.0
}
season_autumn={
"type": "float",
"value": 0.0
}
season_winter={
"type": "float",
"value": 0.0
}
wind_strength={
"type": "float",
"value": 0.0
}
night_amount={
"type": "float",
"value": 0.0
}
rain_glass={
"type": "float",
"value": 0.0
}
frost_glass={
"type": "float",
"value": 0.0
}
